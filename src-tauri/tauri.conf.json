{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BurnRate Tauri",
  "version": "1.0.0",
  "identifier": "com.burnrate.desktop.tauri",
  "build": {
    "frontendDist": "../ui/app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BurnRate",
        "width": 860,
        "height": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "BurnRate",
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI plan usage in the menu bar",
    "longDescription": "Tracks AI plan usage for OpenCode Go, Anthropic Claude and OpenAI Codex plans.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

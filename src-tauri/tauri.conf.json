{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BurnRate Tauri",
  "version": "1.0.0",
  "identifier": "com.burnrate.desktop.tauri",
  "build": {
    "frontendDist": "../ui/app",
    "beforeDevCommand": "npm --prefix ../ui run watch",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BurnRate",
        "minWidth": 780,
        "minHeight": 520,
        "width": 1000,
        "height": 700,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI plan usage in the menu bar",
    "longDescription": "Tracks AI plan usage for OpenCode Go, Anthropic Claude and OpenAI Codex plans.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}

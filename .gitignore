.DS_Store
dist/

# Swift tooling caches. The Swift app is gone, but an editor's stale Swift
# indexer still writes this on a machine that has built it before — and because
# it is full of generated module caches (118 files the first time), it must never
# reach a commit. See AGENTS.md.
.build/
.swiftpm/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Rust
/target/
/src-tauri/target/
/src-tauri/gen/

# Frontend build output and dependencies. The sources are ui/app/src; `tsc`
# emits native ES modules into ui/app/js, which the webview loads directly.
ui/node_modules/
ui/app/js/
